#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose="$root/scripts/docker-compose-local"
trap '"$compose" down --remove-orphans' EXIT INT TERM

"$compose" up --build --detach curley-moq-lite-05-relay
sleep 3

MOQX_LITE_ENDPOINT=moql://localhost:4463/ \
MOQX_LITE_CA_FILE="$root/.tmp/integration-certs/ca.pem" \
  mix test --only moq_lite_05 test/integration
